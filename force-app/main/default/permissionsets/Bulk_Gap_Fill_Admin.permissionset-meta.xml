<?xml version="1.0" encoding="UTF-8" ?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Bulk Gap Fill Admin</label>
    <description
  >Full access to launch, monitor, and review bulk gap fill runs. Net Zero Cloud object access is granted separately by the standard NZC permission set licence.</description>
    <hasActivationRequired>false</hasActivationRequired>

    <classAccesses>
        <apexClass>BulkGapFillController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>BulkGapFillBatch</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>BulkGapFillService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>BulkGapFillRequest</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>BulkGapFillConstants</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>BulkGapFillJobScheduler</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <objectPermissions>
        <object>BulkGapFillJob__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>BulkGapFillJobDetail__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>

    <tabSettings>
        <tab>Bulk_Gap_Fill</tab>
        <visibility>Visible</visibility>
    </tabSettings>
</PermissionSet>
